{
  "scripts": {
    "openapi:fetch": "bash ./src/tools/fetch-api.sh",
    "openapi:fetch:verbose": "bash -x ./src/tools/fetch-api.sh",
    "openapi:generate": "npm run openapi:fetch && openapi-ts -f openapi-ts.config.ts",
    "prisma:fetch": "bash ./src/tools/fetch-api.sh",
    "prisma:generate": "npm run prisma:fetch && bash ./src/tools/prisma-generate.sh",
    "openapi:lint": "spectral lint .cache/mesh-studio.api/openapi/ms/openapi.yaml",
    "openapi:watch": "openapi-ts -f openapi-ts.config.ts -w"
  },
  "dependencies": {
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.31.0",
    "@azure/web-pubsub": "^1.2.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "dotenv": "^17.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.95.0",
    "@stoplight/spectral-cli": "^6.15.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.2",
    "prisma": "^7.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
