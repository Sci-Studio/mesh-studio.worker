# Dependencies / local installs
node_modules/

# Local C++ build output (host CMake cache breaks Docker builds)
# Keep root dist/ — Docker copies the prebuilt TypeScript output.
packages/**/build/
**/CMakeCache.txt
**/CMakeFiles/

# Git / IDE / cache
.git/
.cache/
.vscode/
.idea/
**/.DS_Store

# Env / secrets
.env*
env.*
!env.example
!.env.example

# Logs / coverage
*.log
coverage/
